generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
   
}

model User {
  id                  String   @id @default(uuid())
  email               String?  @unique
  name                String?
  password            String?
  githubId            String?
  capabilitiesSummary String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Lead {
  id                   String    @id @default(uuid())
  companyName          String
  founderName          String?
  domain               String?
  email                String?
  techStack            String?
  engineeringPainPoint String?
  
  // Active Pipeline States: 
  // PENDING, PENDING_ENRICHMENT, PROCESSING, READY_TO_SEND, 
  // REQUIRES_MANUAL_REVIEW, SENT, FAILED, FAILED_NO_CONTACT_FOUND, FAILED_DELIVERY
  status               String    @default("PENDING_ENRICHMENT")
  errorMessage         String?
  finalDraft           String?   // Stores the final markdown email generated by Claude
  
  enrichedAt           DateTime? // 🔥 FIXED: Removed @default(now()) so it stays null until enriched
  createdAt            DateTime  @default(now()) // Added to track when the extension injected it
  updatedAt            DateTime  @updatedAt
}